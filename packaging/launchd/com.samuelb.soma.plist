<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Soma playback daemon, as a per-user LaunchAgent.

  Install (adjust the soma path below to wherever you installed it, e.g.
  /opt/homebrew/bin/soma for a Homebrew install on Apple Silicon,
  /usr/local/bin/soma on Intel, or wherever you copied it from the DMG):
    cp packaging/launchd/com.samuelb.soma.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.samuelb.soma.plist

  Logs: ~/Library/Logs/soma.log (also shown by Console.app). launchd
  expands neither ~ nor $HOME in StandardOutPath, and a fixed path under
  the shared /tmp would be readable by other users, so the daemon is
  started through /bin/sh, which appends its output to that file. (The
  state directory's server.log only collects daemons a client spawned.)

  The supervised flag tells the daemon that launchd restarts it (KeepAlive
  below: after any exit but a successful one). A soma client that needs a
  fresh daemon (after an upgrade, or when the audio device was lost) then
  asks it to exit with status 75 and waits for the restart, instead of
  starting a daemon of its own outside this agent. Keep the flag when you
  change the command.

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.samuelb.soma.plist
    rm ~/Library/LaunchAgents/com.samuelb.soma.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.samuelb.soma</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec /usr/local/bin/soma daemon --supervised &gt;&gt;"$HOME/Library/Logs/soma.log" 2&gt;&amp;1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
